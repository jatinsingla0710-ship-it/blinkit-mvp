# Root / shared public env template for GroAurum apps.
# Copy values into each app's .env.local — never commit secrets or service-role keys.

# development | staging | production
GROAURUM_APP_ENV=development

# mock | supabase
GROAURUM_AUTH_PROVIDER=mock

# Public Supabase only (when AUTH_PROVIDER=supabase)
# GROAURUM_SUPABASE_URL=
# GROAURUM_SUPABASE_ANON_KEY=

# Script/tooling keys (not exposed to Vite unless promoted — prefer VITE_* in app .env.local)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
