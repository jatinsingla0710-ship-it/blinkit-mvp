# GroAurum Delivery PWA — public environment (Vite)
# Copy to apps/delivery-pwa/.env.local (gitignored). Never commit secrets.

VITE_APP_ENV=development
VITE_AUTH_PROVIDER=supabase
VITE_AUTH_MOCK_ROLE=delivery_executive
# Development only. Ignored by production builds. Do not set these on Vercel.
VITE_AUTH_DEV_EMAIL=delivery1@groaurum.local
VITE_AUTH_DEV_PASSWORD=password123
VITE_DATA_ADAPTER=supabase
# Vite also promotes root SUPABASE_URL / SUPABASE_ANON_KEY when app vars are unset.
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# NEVER put CRON_SECRET / Razorpay secrets / FCM keys in VITE_* vars
