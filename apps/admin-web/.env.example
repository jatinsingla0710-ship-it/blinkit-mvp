# GroAurum Admin — public environment (Vite)
# Copy to apps/admin-web/.env.local (gitignored). Never commit secrets.

# development | staging | production
VITE_APP_ENV=development

# mock | supabase (Sprint 5.1: use supabase for live JWT + RLS)
VITE_AUTH_PROVIDER=supabase

# Mock auto-sign-in role (only when VITE_AUTH_PROVIDER=mock)
# super_admin | operations_manager | warehouse_manager | sales_manager
# delivery_manager | read_only
VITE_AUTH_MOCK_ROLE=super_admin

# Development only. `vite dev` may prefill the login form.
# Production builds ignore these and must not set them on Vercel.
VITE_AUTH_DEV_EMAIL=admin@groaurum.local
VITE_AUTH_DEV_PASSWORD=password123

# Data layer: mock (offline fixtures, development only) | supabase (required for production builds)
VITE_DATA_ADAPTER=supabase

# Required when VITE_AUTH_PROVIDER=supabase or VITE_DATA_ADAPTER=supabase
# (do not use service-role key). Values: pnpm exec supabase status -o env
# Vite also promotes root SUPABASE_URL / SUPABASE_ANON_KEY when app vars are unset.
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Public CORS allowlist hint (server secrets live in supabase secrets)
# VITE_ALLOWED_ORIGINS=http://127.0.0.1:5173

# NEVER put these in VITE_* — Edge/server only:
# CRON_SECRET, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET,
# SMS_PROVIDER_API_KEY, WHATSAPP_PROVIDER_API_KEY, EMAIL_PROVIDER_API_KEY, FCM_SERVER_KEY

# Public Customer App URL for WhatsApp app-link sharing
# VITE_CUSTOMER_APP_URL=https://app.groaurum.com
