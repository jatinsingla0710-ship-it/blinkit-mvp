# Non-secret production defaults. Vite loads this for `vite build` and it
# overrides development values from .env.local for these keys only.
# Set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY in the Vercel project.
# Do not put service-role keys, database URLs, or dev passwords here.
VITE_APP_ENV=production
VITE_AUTH_PROVIDER=supabase
VITE_DATA_ADAPTER=supabase
