# Customer app public configuration (Expo)
# Copy to apps/customer/.env. Never put service-role keys in EXPO_PUBLIC_* vars.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# mock | supabase
EXPO_PUBLIC_AUTH_PROVIDER=supabase

# mock = legacy dark-store demo | supabase = live Auth + catalogue + orders
EXPO_PUBLIC_CUSTOMER_DATA_ADAPTER=supabase

# Required when adapter/auth is supabase (from `pnpm exec supabase status -o env`)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Sprint 6 seed login (after supabase/seed/sprint6_customer_seed.sql)
# Email: customer@groaurum.local
# Password: password123
# Invitation token (if unlinked): sprint6-customer-invite-token

# NEVER put CRON_SECRET / Razorpay secrets / service-role in EXPO_PUBLIC_*
