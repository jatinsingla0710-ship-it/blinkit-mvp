# GroAurum Sales PWA — public environment (Vite)
# Copy to apps/sales-pwa/.env.local (gitignored). Never commit secrets.
#
# Data adapter:
#   VITE_DATA_ADAPTER=supabase  → live Supabase (real shops/orders/visits)
#   VITE_DATA_ADAPTER=mock      → in-memory demo data (default if unset)
# When unset during `vite dev`, the app defaults to mock and shows a demo banner.
# Production builds require VITE_DATA_ADAPTER=supabase and do not auto-login.

VITE_APP_ENV=development
VITE_AUTH_PROVIDER=supabase
VITE_AUTH_MOCK_ROLE=salesman
VITE_AUTH_DEV_EMAIL=salesman1@groaurum.local
VITE_AUTH_DEV_PASSWORD=password123
VITE_DATA_ADAPTER=supabase
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# NEVER put CRON_SECRET / Razorpay secrets / FCM keys in VITE_* vars

# Public Customer App URL for WhatsApp app-link sharing
# VITE_CUSTOMER_APP_URL=https://app.groaurum.com
